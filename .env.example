# BunaLens mobile configuration. Only public, restricted client values belong here.
# Demo mode must work with every value below left blank.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_ENABLE_REAL_PAYMENTS=false

# Public Supabase project URL and anon/publishable key (RLS must be enabled).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public Supabase Edge Function endpoints (not secrets).
EXPO_PUBLIC_BUNALENS_SYNC_URL=
EXPO_PUBLIC_CHAPA_INITIALIZE_URL=
EXPO_PUBLIC_CERTIFICATE_VERIFY_BASE_URL=

# Backward-compatible payment demo switch used by the current app.
EXPO_PUBLIC_CHAPA_DEMO_MODE=false

# Backend-only secrets (reference only; do not uncomment in the mobile .env):
# GEMINI_API_KEY=
# CHAPA_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# BUNALENS_INTERNAL_FUNCTION_KEY=
#
# Configure these in Supabase Edge Function Secrets instead. Never put them
# in an EXPO_PUBLIC_* variable, app config, source code, or a mobile build.
